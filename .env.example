GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json
GOOGLE_SHEET_ID=

SEARCHIQS_OUTPUT_DIR=output
SEARCHIQS_DELAY_MIN=1
SEARCHIQS_DELAY_MAX=3
SEARCHIQS_CONNECT_TIMEOUT=15
SEARCHIQS_REQUEST_TIMEOUT=60
SEARCHIQS_MAX_REDIRECTS=5
SEARCHIQS_READ_ATTEMPTS=3
SEARCHIQS_MAX_PAGES=1000
SEARCHIQS_RUN_DEADLINE=7200
SEARCHIQS_BACKOFF_BASE=2
SEARCHIQS_BACKOFF_CAP=60

# Cloudflare clearance from your own browser (see README). Must match the browser's IP and User-Agent.
SEARCHIQS_CF_CLEARANCE=
SEARCHIQS_USER_AGENT=
SEARCHIQS_SEC_CH_UA=
SEARCHIQS_SEC_CH_UA_MOBILE=
SEARCHIQS_SEC_CH_UA_PLATFORM=
SEARCHIQS_ACCEPT_LANGUAGE=
SEARCHIQS_IMPERSONATE=chrome
# PEM bundle for machines whose antivirus or proxy re-signs HTTPS
SEARCHIQS_CA_BUNDLE=
